{
  "info": {
    "name": "Customer Portal - The Steel",
    "_postman_id": "customer-portal-steelpro",
    "description": "All Customer Portal APIs for The Steel / Mr-Storage Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://mr-storage-backend-1.onrender.com/api", "type": "string" },
    { "key": "localUrl", "value": "http://localhost:5001/api", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "leadId", "value": "69e6137ce2dc3d6e7468ca58", "type": "string" },
    { "key": "docId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customer/auth/login", "host": ["{{baseUrl}}"], "path": ["customer", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["const r = pm.response.json();\nconst token = r.data?.accessToken || r.data?.token;\nif (token) pm.collectionVariables.set('customerToken', token);"] }
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customer/auth/refresh", "host": ["{{baseUrl}}"], "path": ["customer", "auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<your_refresh_token>\"\n}" }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customer/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["customer", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\"\n}" }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customer/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["customer", "auth", "verify-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"otp\": \"123456\"\n}" }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customer/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["customer", "auth", "reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"resetToken\": \"<token_from_email>\",\n  \"newPassword\": \"newpassword123\"\n}" }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/auth/change-password", "host": ["{{baseUrl}}"], "path": ["customer", "auth", "change-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"oldpassword\",\n  \"newPassword\": \"newpassword123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/customer/profile", "host": ["{{baseUrl}}"], "path": ["customer", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/profile", "host": ["{{baseUrl}}"], "path": ["customer", "profile"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+1234567890\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/customer/dashboard", "host": ["{{baseUrl}}"], "path": ["customer", "dashboard"] }
          },
          "response": [],
          "_postman_note": "Returns: activeProjects, closedProjects, drawingsAndApprovals, deliveryTracking (inTransit/staged/ready/totalToday/upcomingDeliveries/deliveriesThisWeek/delayedDeliveries/rescheduledDeliveries), shipmentBreakdown, nextDelivery, totalProjectValue, totalPaid, totalPending, upcomingInvoice"
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Get All Projects",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const r = pm.response.json();\nconst first = r.data?.projects?.[0];\nif (first?._id) pm.collectionVariables.set('leadId', first._id);"] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "lifecycleStatus", "value": "", "disabled": true, "description": "filter by status" }
              ]
            }
          },
          "_postman_note": "Returns: projects[], total. Auto-sets {{leadId}} to first project. Each project has: _id, projectName, jobId, lifecycleStatus, location, buildingType, quoteValue"
        },
        {
          "name": "Get Project Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects/{{leadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects", "{{leadId}}"]
            }
          },
          "_postman_note": "Returns: lead, quotation, quoteSummary, invoices[], paymentSchedule"
        },
        {
          "name": "Get Project Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects/{{leadId}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects", "{{leadId}}", "stats"]
            }
          },
          "_postman_note": "Returns: deliveries{total,delivered,inTransit}, payments{totalInvoiced,totalPaid,pending,pendingInvoices}, followUps count, meetings count"
        },
        {
          "name": "Get Project Drawings & Images",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects/{{leadId}}/drawings",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects", "{{leadId}}", "drawings"],
              "query": [
                { "key": "type", "value": "", "disabled": true, "description": "filter: architectural | structural | electrical | mechanical | site | other" }
              ]
            }
          },
          "_postman_note": "Returns: drawings[] (DrawingDocument records), embeddedDocuments[] (from lead.documents), total. Each drawing: name, fileUrl, fileType, fileSize, documentType, status, uploadedBy, approvedBy, notes"
        },
        {
          "name": "Get Project Recent Activity",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects/{{leadId}}/activity?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects", "{{leadId}}", "activity"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "_postman_note": "Returns: activity[] (AuditLog records), total, page, limit. Each entry: type, action, performedBy{name,role}, metadata, createdAt"
        },
        {
          "name": "Get Project Notes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects/{{leadId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects", "{{leadId}}", "notes"]
            }
          },
          "_postman_note": "Returns: notes[] (lead.leadNotes array), generalNotes (lead.notes string), total. Each note: note, addedAt, addedBy"
        },
        {
          "name": "Get Project Follow Ups",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects/{{leadId}}/followups?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects", "{{leadId}}", "followups"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "", "disabled": true, "description": "pending | completed | cancelled" }
              ]
            }
          },
          "_postman_note": "Returns: followUps[], total, page, limit, stats{total,pending,completed}. Each: followUpDate, modeOfContact, notes, status, assignedTo{name,email}"
        },
        {
          "name": "Get Project Meetings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/projects/{{leadId}}/meetings?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "projects", "{{leadId}}", "meetings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "", "disabled": true, "description": "scheduled | completed | cancelled" }
              ]
            }
          },
          "_postman_note": "Returns: meetings[], total, page, limit, stats{total,scheduled,completed,cancelled}. Each: title, meetingTime, mode(online/offline), meetingLink, status, createdBy{name,email}"
        },
        {
          "name": "Get Project RFQ",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/customer/projects/{{leadId}}/rfq", "host": ["{{baseUrl}}"], "path": ["customer", "projects", "{{leadId}}", "rfq"] }
          },
          "_postman_note": "Returns: rfq{jobId, buildingType, roofStyle, sqft, width, length, location, description, quoteValue, isQuoteReady, lifecycleStatus, aiSummary, aiQuoteData}, quotation"
        },
        {
          "name": "Update Project RFQ (building specs)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/projects/{{leadId}}/rfq", "host": ["{{baseUrl}}"], "path": ["customer", "projects", "{{leadId}}", "rfq"] },
            "body": { "mode": "raw", "raw": "{\n  \"buildingType\": \"warehouse\",\n  \"roofStyle\": \"gable\",\n  \"sqft\": \"6000\",\n  \"width\": 60,\n  \"length\": 100,\n  \"location\": \"Dallas, TX\",\n  \"description\": \"Updated specs\"\n}" }
          },
          "_postman_note": "Only allowed before deal_closed stage. Returns: updated fields. Locked stages: deal_closed, payment_done, converted_to_po, sent_to_admin, released_to_plant"
        },
        {
          "name": "Cancel Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/projects/{{leadId}}/cancel", "host": ["{{baseUrl}}"], "path": ["customer", "projects", "{{leadId}}", "cancel"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Customer decided to postpone the project\"\n}" }
          },
          "_postman_note": "Sets isTerminated=true. Reason is required. Cannot cancel if already cancelled or delivered. Reflected in stats.cancelled count."
        },
        {
          "name": "Approve Drawing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/customer/projects/{{leadId}}/drawings/{{docId}}/approve", "host": ["{{baseUrl}}"], "path": ["customer", "projects", "{{leadId}}", "drawings", "{{docId}}", "approve"] }
          },
          "_postman_note": "Sets drawing status to approved. Returns: {_id, name, status}. Set {{docId}} from drawings list response."
        },
        {
          "name": "Request Drawing Revision",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/projects/{{leadId}}/drawings/{{docId}}/request-revision", "host": ["{{baseUrl}}"], "path": ["customer", "projects", "{{leadId}}", "drawings", "{{docId}}", "request-revision"] },
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Please adjust the roof pitch from 3:12 to 4:12\"\n}" }
          },
          "_postman_note": "Sets drawing status to under_review + saves revisionNote. Note is required. Returns: {_id, name, status, revisionNote}."
        },
        {
          "name": "Create Project (Enquiry)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/projects", "host": ["{{baseUrl}}"], "path": ["customer", "projects"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buildingType\": \"warehouse\",\n  \"location\": \"Pune, Maharashtra\",\n  \"roofStyle\": \"gable\",\n  \"sqft\": \"5000\",\n  \"width\": 50,\n  \"length\": 100,\n  \"description\": \"Steel warehouse building\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Drawings & Documents",
      "item": [
        {
          "name": "Get All Documents (Drawings + Docs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/documents",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "documents"],
              "query": [{ "key": "type", "value": "", "disabled": true, "description": "filter: drawing | approval | contract | invoice | document" }]
            }
          }
        },
        {
          "name": "Get Drawings Only",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/documents?type=drawing",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "documents"],
              "query": [{ "key": "type", "value": "drawing" }]
            }
          }
        },
        {
          "name": "Get Contract Documents Only",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/documents?type=contract",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "documents"],
              "query": [{ "key": "type", "value": "contract" }]
            }
          }
        }
      ]
    },
    {
      "name": "Delivery Schedule",
      "item": [
        {
          "name": "Upcoming Deliveries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/deliveries?tab=upcoming",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "deliveries"],
              "query": [{ "key": "tab", "value": "upcoming", "description": "upcoming | past | rescheduled" }]
            }
          },
          "_postman_note": "Returns: deliveries[], total, tabs{upcoming, past, rescheduled counts}. Each delivery has: deliveryId, deliveryNumber, status, description, deliveryDate, timings, siteContact, deliveryCompany, project"
        },
        {
          "name": "Past Deliveries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/deliveries?tab=past",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "deliveries"],
              "query": [{ "key": "tab", "value": "past" }]
            }
          }
        },
        {
          "name": "Rescheduled Deliveries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/deliveries?tab=rescheduled",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "deliveries"],
              "query": [{ "key": "tab", "value": "rescheduled" }]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get Payments (Upcoming + Overdue + History)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/customer/payments", "host": ["{{baseUrl}}"], "path": ["customer", "payments"] }
          },
          "_postman_note": "Returns: upcoming[], overdue[], paid[] — each has invoice details + dueDate + lead info"
        },
        {
          "name": "Get Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customer/payments/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "payments", "invoices"],
              "query": [{ "key": "status", "value": "", "disabled": true, "description": "paid | sent | draft" }]
            }
          }
        },
        {
          "name": "Get Tax Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/customer/payments/tax-report", "host": ["{{baseUrl}}"], "path": ["customer", "payments", "tax-report"] }
          },
          "_postman_note": "Returns: rows[] (date, invoiceNumber, projectId, projectName, buildingType, location, contractAmount, taxRate%, taxDue), summary{totalContractAmount, totalTaxDue}"
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Get Presigned URL (S3 Upload)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/upload/presigned-url", "host": ["{{baseUrl}}"], "path": ["customer", "upload", "presigned-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"document.pdf\",\n  \"fileType\": \"application/pdf\",\n  \"folder\": \"customer-uploads\"\n}"
            }
          }
        }
      ]
    }
  ]
}
