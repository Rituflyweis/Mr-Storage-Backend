PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/construction-ai

# JWT
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Claude context tuning — set to 0 to disable trimming in dev
CLAUDE_MAX_PRIOR_CONTEXT_CHARS=45000
CLAUDE_MAX_LIVE_CONTEXT_CHARS=28000
CLAUDE_CONTEXT_SUMMARY_MAX_CHARS=2200
CLAUDE_LIVE_VERBATIM_TURNS=12
CLAUDE_MAX_SCORE_PRIOR_CHARS=22000
CLAUDE_MAX_SCORE_LIVE_CHARS=18000

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PRESIGNED_URL_EXPIRES=300

# SendGrid email
SENDGRID_API_KEY=SG.xxxxxxxx
# Optional: defaults to MAIL_FROM when omitted
SENDGRID_FROM="Construction AI <verified-sender@yourdomain.com>"
MAIL_FROM="Construction AI <verified-sender@yourdomain.com>"

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Invoice email / PDF company block (optional — defaults to Steel Building Depot)
# INVOICE_COMPANY_NAME=STEEL BUILDING DEPOT
# INVOICE_COMPANY_ADDRESS=1851 Madison Ave Suite 300|Council Bluffs, IA|51503|United States
# INVOICE_COMPANY_EMAIL=travis@storagematerials.com
# INVOICE_COMPANY_WEBSITE=www.storagematerials.com
# INVOICE_LOGO_URL=https://example.com/logo.png
